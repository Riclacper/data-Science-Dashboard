# Supabase: Settings > Database > Connection string > URI
# Substitua os valores entre colchetes e mantenha sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Origens autorizadas a consumir a API, separadas por vírgula.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

FLASK_DEBUG=false
