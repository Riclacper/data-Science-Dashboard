# MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/forense?retryWrites=true&w=majority

# Credenciais de login do dashboard
LOGIN_USER=admin
LOGIN_PASS=minha_senha_segura

# E-mail para envio de relatórios
EMAIL_ORIGEM=seuemail@gmail.com
# SENHA_APP deve ser uma Senha de App do Google (não a senha da conta).
# Gere em: https://myaccount.google.com/apppasswords
SENHA_APP=xxxx_xxxx_xxxx_xxxx

# SMTP (padrão Gmail SSL; ajuste para outro provedor se necessário)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Ambiente Flask (production / development)
FLASK_ENV=production
